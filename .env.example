# Settings for `docker compose` (copy to `.env` next to compose.yaml). Everything is optional: with
# no .env, compose starts its own RustFS storage and works as it is.

# ---- Change the login of the bundled storage (used by the app and the storage alike) ------------
# S3_ACCESS_KEY=cloudvault
# S3_SECRET_KEY=a-long-random-secret
# S3_BUCKET=cloudvault

# ---- Or use a storage you already have, and start only the app -----------------------------------
#   docker compose up --build --no-deps cloudvault
# STORAGE_PROVIDER=r2                  # minio, s3 or r2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=                  # only if the browser reaches the storage at another address
# S3_REGION=auto
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_ADDRESSING_STYLE=path
# S3_CREATE_BUCKET=false               # compose creates the bundled storage's bucket; a real one should exist
