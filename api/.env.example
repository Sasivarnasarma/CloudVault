STORAGE_PROVIDER=minio

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cloudvault
S3_ADDRESSING_STYLE=path

# Optional: the address the browser uses to reach the storage, when it is not the one above (for
# example in Docker, where the API sees http://minio:9000 and the browser http://localhost:9000).
# Presigned links are made for this address.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Optional: largest single upload accepted, in bytes. Default is 5 TiB, S3's own maximum.
# MAX_UPLOAD_BYTES=5497558138880

# Where `pnpm dev` / `pnpm start` listen. Local only by default: there is no sign-in.
# HOST=127.0.0.1
# PORT=8000

CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
